# ---------------------------------------------------------------------------
# Rain Corrector - environment template
# Copy to `.env` and adjust. Never commit a filled-in `.env`.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME=Rain Corrector
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_VERSION=v1

# --- Backend --------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text | json

# --- Database -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=rain_corrector
POSTGRES_USER=rain
POSTGRES_PASSWORD=rain_dev_password
DATABASE_URL=postgresql+psycopg://rain:rain_dev_password@localhost:55432/rain_corrector
# Async driver used by the application at runtime
ASYNC_DATABASE_URL=postgresql+asyncpg://rain:rain_dev_password@localhost:55432/rain_corrector
# Engine tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Security -------------------------------------------------------------
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000
# Secret used to sign API keys issued by scripts/seed_data.py.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying
API_KEY_HEADER=X-API-Key
ENABLE_API_KEY_AUTH=false

# --- ML inference ---------------------------------------------------------
MODEL_ARTIFACT_PATH=../ml/artifacts
# Explicit version to serve. When unset the version flagged active in the
# database is used.
MODEL_VERSION=
MODEL_LOAD_ON_STARTUP=true
MODEL_INFERENCE_TIMEOUT_SECONDS=10

# --- ML training ----------------------------------------------------------
ML_RANDOM_SEED=42
ML_TRAINING_DATA_PATH=../data/processed
ML_RAW_DATA_PATH=../data/raw
ML_ARTIFACT_OUTPUT_PATH=../ml/artifacts

# --- Data ingestion -------------------------------------------------------
DATA_PROVIDER=local_csv           # local_csv | open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=20
# Set to false to keep the seeded demo dataset untouched.
ENABLE_EXTERNAL_INGESTION=false

# --- Verification / jobs --------------------------------------------------
# Hours after a forecast's target time before it is eligible for verification.
VERIFICATION_GRACE_PERIOD_HOURS=6
RETRAINING_MIN_INTERVAL_HOURS=168
DEFAULT_FORECAST_HORIZON_HOURS=24
DEFAULT_PROMOTION_POLICY=auto_promote_if_better

# --- Frontend (public: safe to expose in the browser) ---------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_MAX_ZOOM=19
NEXT_PUBLIC_MAP_TILE_PROVIDER=OpenStreetMap Standard
